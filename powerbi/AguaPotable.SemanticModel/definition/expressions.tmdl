/// Dirección del servidor del tablero (Node.js)
expression UrlServidor = "http://localhost:3000" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	annotation PBI_ResultType = Text

/// Días de historia a cargar (desde hoy 00:00 hacia atrás)
expression Dias = 30 meta [IsParameterQuery = true, Type = "Number", IsParameterQueryRequired = true]
	annotation PBI_ResultType = Number

/// Resolución de los datos: 5m, 15m, 30m, 1h o 1d
expression Intervalo = "15m" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	annotation PBI_ResultType = Text
