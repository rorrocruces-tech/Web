# Copie este archivo como .env y complete los valores.

# Origen de datos:
#   pisdk  -> usa el PI SDK instalado con PI ProcessBook (Windows, NO requiere PI Web API)
#   webapi -> usa PI Web API (complete PI_WEBAPI_URL y credenciales)
#   sim    -> valores simulados (por defecto si no hay PI_WEBAPI_URL)
PI_SOURCE=pisdk

# ---- Opciones PI SDK (PI_SOURCE=pisdk) ----
# Cadena de conexión opcional. Vacío = la misma conexión que usa ProcessBook (trust / usuario por defecto)
# PISDK_CONNECT=UID=lector;PWD=clave
# Ruta de PowerShell. Por defecto la de 32 bits (C:\Windows\SysWOW64\...), igual que ProcessBook 3.x
# PISDK_POWERSHELL=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe

# ---- Opciones PI Web API (PI_SOURCE=webapi) ----

# URL base de PI Web API (termina en /piwebapi)
# PI_WEBAPI_URL=https://PISRV01.miempresa.local/piwebapi

# Autenticación Basic (usuario de dominio de SOLO LECTURA). Ej: MIEMPRESA\svc_tablero
PI_USER=
PI_PASSWORD=

# Certificado de la CA interna (recomendado) en formato PEM
PI_CA_FILE=
# Sólo para pruebas con certificado autofirmado: false desactiva la validación TLS
PI_REJECT_UNAUTHORIZED=true
# Tiempo máximo de espera por consulta a PI (ms)
PI_TIMEOUT_MS=20000

# Servidor web
PORT=3000
HOST=0.0.0.0
# Frecuencia de lectura a PI (ms). Una sola consulta sirve a todos los usuarios.
POLL_MS=5000
# Archivo de configuración de tags
# TAGS_FILE=config/tags.json
# Forzar simulación aunque haya URL
# SIMULATE=true
