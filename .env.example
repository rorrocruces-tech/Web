# Copie este archivo como .env y complete los valores.

# Origen de datos:
#   pisdk  -> usa el PI SDK instalado con PI ProcessBook (Windows, NO requiere PI Web API)
#   webapi -> usa PI Web API (complete PI_WEBAPI_URL y credenciales)
#   sim    -> valores simulados (por defecto si no hay PI_WEBAPI_URL)
PI_SOURCE=pisdk

# ---- Opciones PI SDK (PI_SOURCE=pisdk) ----
# Cadena de conexión opcional. Vacío = la misma conexión que usa ProcessBook (trust / usuario por defecto)
# PISDK_CONNECT=UID=lector;PWD=clave
# Ruta de PowerShell. Por defecto la de 32 bits (C:\Windows\SysWOW64\...), igual que ProcessBook 3.x
# PISDK_POWERSHELL=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe

# ---- Opciones PI Web API (PI_SOURCE=webapi) ----

# URL base de PI Web API (termina en /piwebapi)
# PI_WEBAPI_URL=https://PISRV01.miempresa.local/piwebapi

# Autenticación Basic (usuario de dominio de SOLO LECTURA). Ej: MIEMPRESA\svc_tablero
PI_USER=
PI_PASSWORD=

# Certificado de la CA interna (recomendado) en formato PEM
PI_CA_FILE=
# Sólo para pruebas con certificado autofirmado: false desactiva la validación TLS
PI_REJECT_UNAUTHORIZED=true
# Tiempo máximo de espera por consulta a PI (ms)
PI_TIMEOUT_MS=20000

# Servidor web
PORT=3000
HOST=0.0.0.0
# Frecuencia de lectura a PI (ms). Una sola consulta sirve a todos los usuarios.
POLL_MS=5000
# Archivo de configuración de tags
# TAGS_FILE=config/tags.json
# Forzar simulación aunque haya URL
# SIMULATE=true

# ---- Avisos por SMS cuando un equipo se DETIENE ----
# Apagado salvo SMS_ENABLED=true. Proveedor: httpsms (por defecto) o twilio.
# SMS_ENABLED=true
# SMS_PROVIDER=httpsms

# Destinatarios de toda detención (uno o varios, separados por coma)
# SMS_TO=+56990000001,+56990000002
# Destinatarios EXTRA sólo para fallas (Falla/Trip). Opcional.
# SMS_TO_FALLA=+56990000003
# Espera mínima entre avisos del MISMO equipo (minutos)
# SMS_COOLDOWN_MIN=30
# Tiempo máximo de espera por cada envío (ms)
# SMS_TIMEOUT_MS=15000

# --- Opción A: httpSMS (app en un Android con SIM) ---
# SMS_API_URL=https://api.httpsms.com/v1/messages/send
# SMS_API_KEY=pegue_aqui_su_api_key_de_httpsms
# SMS_FROM=+56956871072                 # número del Android central

# --- Opción B: Twilio (nube; use SMS_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=su_auth_token
# SMS_FROM=+1XXXXXXXXXX                  # su número Twilio (o un Messaging Service MGxxxx)
# Canal: sms (por defecto) o whatsapp. Para WhatsApp Sandbox use el número del
# sandbox en SMS_FROM (p. ej. +14155238886) y una la sesión desde su WhatsApp.
# En producción WhatsApp exige plantilla aprobada por Meta.
# SMS_CHANNEL=whatsapp
